# =============================================================================
# Variables de entorno del backend y de docker compose.
# Copia este archivo a ".env" (ignorado por git) y ajusta los valores.
#   - Desarrollo: docker-compose.dev.yml ya trae sus valores; este .env es opcional.
#   - Producción: usa la sección PRODUCCIÓN de abajo (descoméntala) con docker-compose.yml.
# Guía paso a paso: docs/PRODUCCION.md
# =============================================================================

# -----------------------------------------------------------------------------
# DESARROLLO (localhost)
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-solo-para-desarrollo
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:8000

# Base de datos (fuera de Docker; en Docker el host es "db")
DB_ENGINE=django.db.backends.postgresql
DB_NAME=coffe_saas
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (caché y límites anti-abuso). Vacío = memoria local.
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# -----------------------------------------------------------------------------
# PRODUCCIÓN (ejemplo con el dominio cafe.midominio.com)
# En el servidor: borra la sección DESARROLLO de arriba y descomenta esta.
# Nada de localhost: todo apunta al dominio real con https.
# -----------------------------------------------------------------------------
# DEBUG=False
#
# # OBLIGATORIA. Clave secreta propia (NUNCA la de desarrollo), de 50 caracteres o más. Generar con:
# #   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# # (token_urlsafe no produce "$", que docker compose interpretaría como variable)
# # Si queda vacía, docker compose no arranca; si es corta o de ejemplo, Django no arranca.
# # Guárdala también en un gestor de contraseñas: sin ella no se puede reconstruir el servidor.
# SECRET_KEY=
#
# # Dominio(s) por los que se entra al sistema, sin https:// ni barra
# ALLOWED_HOSTS=cafe.midominio.com
# # Mismo dominio pero con https:// (formularios con sesión, p. ej. el admin de Django)
# CSRF_TRUSTED_ORIGINS=https://cafe.midominio.com
# # Web y API en el mismo dominio (/api): se puede dejar vacío.
# # Si la web va en app.midominio.com y el API en api.midominio.com: CORS_ALLOWED_ORIGINS=https://app.midominio.com
# CORS_ALLOWED_ORIGINS=
#
# # Base de datos del docker-compose.yml (el host "db" ya lo pone el compose)
# DB_NAME=coffe_saas
# DB_USER=postgres
# # OBLIGATORIA (si queda vacía, docker compose no arranca). Generar igual que SECRET_KEY, sin "$":
# #   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DB_PASSWORD=
#
# # Frontend (se incrustan al compilar: si cambian, `docker compose build frontend`)
# # Vacío = el API está en el mismo dominio (/api/v1). Solo se llena si el API va en otro subdominio:
# #   REACT_APP_API_URL=https://api.midominio.com/api/v1
# REACT_APP_API_URL=
# # Dominio definitivo que se imprime en los QR de las mesas
# REACT_APP_PUBLIC_URL=https://cafe.midominio.com
#
# # Puerto local (solo 127.0.0.1) al que apunta el proxy con HTTPS (Caddy/nginx)
# FRONTEND_PORT=8088
# # Workers de gunicorn (2 x núcleos + 1)
# WEB_CONCURRENCY=3
#
# # Email: hoy el sistema NO envía correos (no hay recuperación de contraseña por correo ni avisos).
# # Estas variables quedan listas para cuando se agregue esa función; mientras tanto se pueden omitir.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
#
# # --- Opcionales: ya tienen valores seguros por defecto con DEBUG=False ---
# # SECURE_SSL_REDIRECT=True        # redirige http -> https
# # SECURE_HSTS_SECONDS=3600        # subir a 31536000 (1 año) cuando el HTTPS esté probado
# # COMENSAL_COOKIE_SECURE=True     # cookie del cliente solo por HTTPS (no desactivar en producción)
# # NUM_PROXIES=2                   # proxies delante de Django (proxy HTTPS + nginx del frontend).
# #                                 # También 2 con Cloudflare: ver docs/PRODUCCION.md, paso 4.
# # USE_X_FORWARDED_PROTO=True      # confiar en X-Forwarded-Proto del proxy
# # USE_X_FORWARDED_HOST=True       # confiar en X-Forwarded-Host del proxy
# # TENANT_HOSTS_SIN_SUBDOMINIO=    # por defecto: localhost, 127.0.0.1 y ALLOWED_HOSTS
