# Variables del frontend (React, Create React App).
# IMPORTANTE: CRA incrusta las REACT_APP_* en el build. Si cambian, hay que volver a compilar
# (en Docker: `docker compose build frontend`). Nunca pongas secretos aquí: quedan visibles en el navegador.
#
# Archivos que lee CRA:
#   .env.development        -> solo `npm start` (incluido en el repo, apunta a localhost)
#   .env.production         -> solo `npm run build` (crear a partir de .env.production.example; ignorado por git)
#   *.local                 -> ajustes personales, ignorados por git

# URL del API.
#   - Vacío (recomendado en producción): se usa /api/v1 en el mismo dominio que la web.
#   - En desarrollo, si está vacío, se usa http://localhost:8000/api/v1.
#   - Si el API vive en otro subdominio: https://api.midominio.com/api/v1
REACT_APP_API_URL=

# Dominio público que se imprime en los QR de las mesas (sin barra final).
#   - Vacío: el origen desde el que se abre el panel (correcto si el panel se usa desde el dominio real).
#   - Ejemplo: https://cafe.midominio.com
REACT_APP_PUBLIC_URL=
