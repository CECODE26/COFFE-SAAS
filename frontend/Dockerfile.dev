# Development stage - Hot reload
FROM node:16-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install npm 8 for better compatibility
RUN npm install -g npm@8

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy app source
COPY . .

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "start"]
