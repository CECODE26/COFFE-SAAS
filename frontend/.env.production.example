# Plantilla del frontend para PRODUCCIÓN. Solo hace falta si compilas fuera de Docker:
#   cp .env.production.example .env.production && npm run build
# Con docker compose estas variables se toman del .env de la raíz del proyecto (build args).
# Las REACT_APP_* quedan incrustadas en el build: si cambian, hay que volver a compilar.

# Vacío = el API está en el mismo dominio que la web, bajo /api/v1 (topología recomendada).
# Si el API vive en un subdominio aparte: REACT_APP_API_URL=https://api.midominio.com/api/v1
REACT_APP_API_URL=

# Dominio definitivo que se imprime en los QR de las mesas (sin barra final).
REACT_APP_PUBLIC_URL=https://cafe.midominio.com

# No generar source maps (.map): si no, el código fuente original queda público en /static/js/.
# (El Dockerfile ya lo fija; esto cubre el build fuera de Docker.)
GENERATE_SOURCEMAP=false
