# Variables del frontend en DESARROLLO (CRA carga este archivo solo con `npm start`).
# No lleva secretos: se puede subir al repositorio. Para cambios personales usa .env.development.local
# (ignorado por git). Las variables definidas en el entorno (p. ej. docker-compose.dev.yml) tienen prioridad.

# API del backend local (Django en el puerto 8000)
REACT_APP_API_URL=http://localhost:8000/api/v1

# Dominio que se imprime en los QR de las mesas. Vacío = el origen desde el que se abre el panel.
REACT_APP_PUBLIC_URL=
